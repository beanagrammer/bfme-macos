+/***********************************************************************
+ *              parse_decimal
+ *
+ * Parse a non-negative decimal number out of a registry string.  Returns 0 for
+ * anything that is not one, which every caller treats as "out of range".
+ */
+static double parse_decimal(const WCHAR *str)
+{
+    double whole = 0, frac = 0, div = 1;
+    const WCHAR *p = str;
+
+    if (!p || !*p) return 0;
+    for (; *p >= '0' && *p <= '9'; p++)
+        whole = whole * 10 + (*p - '0');
+    if (*p == '.' || *p == ',')
+    {
+        for (p++; *p >= '0' && *p <= '9'; p++)
+        {
+            div *= 10;
+            frac = frac * 10 + (*p - '0');
+        }
+    }
+    if (*p) return 0;   /* trailing junk: reject rather than silently truncate */
+    return whole + frac / div;
+}
+
+
 /***********************************************************************
  *              setup_options
  *
@@ -377,6 +404,26 @@ static void setup_options(void)
     if (!get_config_key(hkey, NULL, "RetinaMode", buffer, sizeof(buffer)))
         retina_enabled = IS_OPTION_TRUE(buffer[0]);
 
+    /* Retina mode normally means exactly two Win32 pixels per Cocoa point.  A
+       fractional scale lets a fixed-resolution virtual desktop be shown at the
+       size of the Mac screen instead of a half-size window, which matters for
+       games that only run correctly at one resolution. */
+    if (!get_config_key(hkey, NULL, "RetinaScale", buffer, sizeof(buffer)))
+    {
+        double value = parse_decimal(buffer);
+        if (value >= 1.0 && value <= 8.0)
+            retina_scale = value;
+        else
+            ERR("ignoring out-of-range RetinaScale (must be between 1 and 8)\n");
+    }
+
+    /* Cocoa refuses to leave a window underneath the menu bar unless it covers a
+       whole screen, which silently shifts the Win32 origin down.  Applications
+       that drive themselves with absolute screen coordinates then click in the
+       wrong place, so allow that constraint to be turned off. */
+    if (!get_config_key(hkey, appkey, "ConstrainWindows", buffer, sizeof(buffer)))
+        constrain_windows = IS_OPTION_TRUE(buffer[0]);
+
     retina_on = retina_enabled;
 
     if (appkey) NtClose(appkey);
