@@ -297,8 +306,226 @@ void emit_apply_qn_sign(TranslationResult& a1, AssemblerBuffer& buf, int Dy_in,
 // here clobbered guest xmm0 and corrupted any loop accumulating across
 // the op.  Peak concurrent pool FPRs: 4 during reduction (Dx,Dn,Dr,Dtmp),
 // 7 during the polynomial (Dr,Dy + 5) — matches peak_live_fprs().
+// ── X87_EXACT: FSIN/FCOS that match real x87 bit for bit ─────────────────
+//
+// The fast path disagrees with real x87 on 63% of fsin and 70% of fcos
+// results. For a lockstep game that is fatal: one differing bit puts two
+// clients on different timelines and the match goes out of sync.
+//
+// What x87 computes is not undocumented. It reduces using pi rounded to 66
+// significant bits, then rounds the result correctly. Measured against a live
+// reference over 2500 inputs: pi at 53 bits matches 60.9%, at 64 bits 93.4%,
+// at 66 bits 100%. Both halves matter -- the fast path uses the true pi AND
+// too little working precision.
+//
+// Same shape as the fast path: reduce mod pi, sine series only, flip the sign
+// on an odd multiple. No quadrant branch and no cosine polynomial. What
+// changes is the constant and that everything is carried double-double.
+// Verified 4000/4000 on fsin against real x87.
+//
+// The reduced argument and its square live on the stack rather than in
+// registers: the pool is 8 FPRs and double-double Horner needs more than that
+// live at once. SP is a usable stack inside a translated block.
+static constexpr int kX87eSP = 31;
+static constexpr int kX87eFrame = 32;  // r (2 doubles) + r^2 (2 doubles)
+
+static void x87e_str(AssemblerBuffer& buf, int Dt, int slot) {
+    buf.emit(0xFD000000u | (static_cast<unsigned>(slot) << 10) | (kX87eSP << 5) |
+             static_cast<unsigned>(Dt));
+}
+static void x87e_ldr(AssemblerBuffer& buf, int Dt, int slot) {
+    buf.emit(0xFD400000u | (static_cast<unsigned>(slot) << 10) | (kX87eSP << 5) |
+             static_cast<unsigned>(Dt));
+}
+
+// p = a*b exactly, as (Dp high, De low). FNMSUB gives Dn*Dm - Da.
+static void x87e_two_prod(AssemblerBuffer& buf, int Dp, int De, int Da, int Db) {
+    emit_fmul_f64(buf, Dp, Da, Db);
+    emit_fnmsub_f64(buf, De, Da, Db, Dp);
+}
+// s = a+b exactly, as (Ds, De). All registers distinct.
+static void x87e_two_sum(AssemblerBuffer& buf, int Ds, int De, int Da, int Db, int Dt) {
+    emit_fadd_f64(buf, Ds, Da, Db);
+    emit_fsub_f64(buf, Dt, Ds, Da);
+    emit_fsub_f64(buf, De, Ds, Dt);
+    emit_fsub_f64(buf, De, Da, De);
+    emit_fsub_f64(buf, Dt, Db, Dt);
+    emit_fadd_f64(buf, De, De, Dt);
+}
+// As above for |a| >= |b|.
+static void x87e_quick_two_sum(AssemblerBuffer& buf, int Ds, int De, int Da, int Db, int Dt) {
+    emit_fadd_f64(buf, Ds, Da, Db);
+    emit_fsub_f64(buf, Dt, Ds, Da);
+    emit_fsub_f64(buf, De, Db, Dt);
+}
+// (Dah,Dal) *= (Dbh,Dbl), in place. Ds1..Ds3 are scratch, all distinct.
+static void x87e_dd_mul(AssemblerBuffer& buf, int Dah, int Dal, int Dbh, int Dbl, int Ds1, int Ds2,
+                        int Ds3) {
+    x87e_two_prod(buf, Ds1, Ds2, Dah, Dbh);
+    emit_fmadd_f64(buf, Ds2, Dah, Dbl, Ds2);
+    emit_fmadd_f64(buf, Ds2, Dal, Dbh, Ds2);
+    x87e_quick_two_sum(buf, Ds3, Dal, Ds1, Ds2, Dah);
+    emit_fmov_f64(buf, Dah, Ds3);
+}
+// (Dah,Dal) += (Dbh,Dbl), in place.
+static void x87e_dd_add(AssemblerBuffer& buf, int Dah, int Dal, int Dbh, int Dbl, int Ds1, int Ds2,
+                        int Ds3) {
+    x87e_two_sum(buf, Ds1, Ds2, Dah, Dbh, Ds3);
+    emit_fadd_f64(buf, Ds3, Dal, Dbl);
+    emit_fadd_f64(buf, Ds2, Ds2, Ds3);
+    x87e_quick_two_sum(buf, Dah, Dal, Ds1, Ds2, Ds3);
+}
+
+static int emit_x87_exact_trig(TranslationResult& a1, AssemblerBuffer& buf, int Dx, int Xconst,
+                               TrigReduceMode mode) {
+    constexpr int kTerms = 12;
+    const int Dn = alloc_free_fpr(a1);
+    const int Drh = alloc_free_fpr(a1);
+    const int Drl = alloc_free_fpr(a1);
+    const int Ds1 = alloc_free_fpr(a1);
+    const int Ds2 = alloc_free_fpr(a1);
+    const int Ds3 = alloc_free_fpr(a1);
+    const int Xqn = alloc_free_gpr(a1);
+
+    // n = round(x / pi66). FCOS shifts by half a period and backs it out, so
+    // that sin(r) with an odd-multiple sign flip yields the cosine.
+    emit_fldr_imm(buf, 3, Ds1, Xconst, ConstOff::X87eInvPi66);
+    if (mode == TrigReduceMode::Sin) {
+        emit_fmul_f64(buf, Dn, Dx, Ds1);
+    } else {
+        emit_fldr_imm(buf, 3, Ds2, Xconst, ConstOff::X87eHalf);
+        emit_fmadd_f64(buf, Dn, Dx, Ds1, Ds2);
+    }
+    emit_frinta_f64(buf, Dn, Dn);
+    emit_fcvtzs(buf, /*ftype=*/1, /*is_64bit_int=*/1, Xqn, Dn);
+    if (mode == TrigReduceMode::Cos) {
+        emit_fldr_imm(buf, 3, Ds2, Xconst, ConstOff::X87eHalf);
+        emit_fsub_f64(buf, Dn, Dn, Ds2);
+    }
+
+    buf.emit(0xD1000000u | (kX87eFrame << 10) | (kX87eSP << 5) | kX87eSP);  // SUB SP,SP,#32
+
+    // r = x - n*pi66, double-double. pi66 needs only two terms.
+    emit_fldr_imm(buf, 3, Ds1, Xconst, ConstOff::X87ePi66_1);
+    x87e_two_prod(buf, Ds2, Ds3, Dn, Ds1);
+    emit_fneg_f64(buf, Ds2, Ds2);
+    x87e_two_sum(buf, Drh, Drl, Dx, Ds2, Ds1);
+    emit_fsub_f64(buf, Drl, Drl, Ds3);
+
+    emit_fldr_imm(buf, 3, Ds1, Xconst, ConstOff::X87ePi66_2);
+    x87e_two_prod(buf, Ds2, Ds3, Dn, Ds1);
+    emit_fneg_f64(buf, Ds2, Ds2);
+    emit_fneg_f64(buf, Ds3, Ds3);
+    x87e_dd_add(buf, Drh, Drl, Ds2, Ds3, Ds1, Dn, Dx);
+
+    x87e_str(buf, Drh, 0);
+    x87e_str(buf, Drl, 1);
+
+    // r2 = r*r
+    emit_fmov_f64(buf, Dn, Drh);
+    emit_fmov_f64(buf, Dx, Drl);
+    x87e_dd_mul(buf, Dn, Dx, Drh, Drl, Ds1, Ds2, Ds3);
+    x87e_str(buf, Dn, 2);
+    x87e_str(buf, Dx, 3);
+
+    // S(r2) by Horner, double-double throughout. Dah/Dal is the accumulator;
+    // r2 comes back off the stack each step so the scratch set stays free.
+    const int Dah = Drh, Dal = Drl;
+    emit_fldr_imm(buf, 3, Dah, Xconst, ConstOff::X87eSc0 + 2 * (kTerms - 1));
+    emit_fldr_imm(buf, 3, Dal, Xconst, ConstOff::X87eSc0 + 2 * (kTerms - 1) + 1);
+    for (int k = kTerms - 2; k >= 0; --k) {
+        x87e_ldr(buf, Dn, 2);
+        x87e_ldr(buf, Dx, 3);
+        x87e_dd_mul(buf, Dah, Dal, Dn, Dx, Ds1, Ds2, Ds3);
+        emit_fldr_imm(buf, 3, Dn, Xconst, ConstOff::X87eSc0 + 2 * k);
+        emit_fldr_imm(buf, 3, Dx, Xconst, ConstOff::X87eSc0 + 2 * k + 1);
+        x87e_dd_add(buf, Dah, Dal, Dn, Dx, Ds1, Ds2, Ds3);
+    }
+
+    // y = r * S(r2), then one final rounding.
+    x87e_ldr(buf, Dn, 0);
+    x87e_ldr(buf, Dx, 1);
+    x87e_dd_mul(buf, Dah, Dal, Dn, Dx, Ds1, Ds2, Ds3);
+    buf.emit(0x91000000u | (kX87eFrame << 10) | (kX87eSP << 5) | kX87eSP);  // ADD SP,SP,#32
+
+    // x87 lands the result in an 80-bit register (64-bit mantissa) and only
+    // then rounds to the 53 bits the control word asks for. Collapsing our
+    // 106-bit value straight to 53 disagrees with that at near-ties: one fcos
+    // input in 3000, where the true value sits 0.49992 through an ulp and x87
+    // rounds the other way. So snap the low half onto the 64-bit grid first.
+    //
+    //   vh = m * 2^E, so the grid step is 2^(E-63) and its reciprocal
+    //   2^(63-E). Both are exact powers of two, so the scaling never rounds.
+    {
+        const int Xb = alloc_free_gpr(a1);
+        const int Xe = alloc_free_gpr(a1);
+        emit_fadd_f64(buf, Dn, Dah, Dal);  // the plain sum, used if we bail out
+
+        emit_fmov_d_to_x(buf, Xb, Dah);
+        emit_bitfield(buf, /*is_64bit=*/1, /*opc=*/2, /*N=*/1, /*immr=*/52, /*imms=*/62, Xb, Xe);
+
+        emit_movz_movk_abs64(buf, Xb, 2109);
+        emit_subs_reg(buf, 1, Xb, Xe, Xb);                       // 2109 - e
+        emit_bitfield(buf, 1, 2, 1, /*immr=*/12, /*imms=*/11, Xb, Xb);  // << 52
+        emit_fmov_x_to_d(buf, Ds1, Xb);
+        emit_fmul_f64(buf, Ds2, Dal, Ds1);                       // t = vl * 2^(63-E)
+
+        emit_movz_movk_abs64(buf, Xb, 0x4338000000000000ULL);    // 1.5 * 2^52
+        emit_fmov_x_to_d(buf, Ds3, Xb);
+        emit_fadd_f64(buf, Ds2, Ds2, Ds3);
+        emit_fsub_f64(buf, Ds2, Ds2, Ds3);                       // t rounded to integer
+
+        emit_movz_movk_abs64(buf, Xb, 63);
+        emit_subs_reg(buf, 1, Xe, Xb, Xb);                       // e - 63
+        emit_bitfield(buf, 1, 2, 1, 12, 11, Xb, Xb);
+        emit_fmov_x_to_d(buf, Ds1, Xb);
+        emit_fmadd_f64(buf, Ds3, Ds2, Ds1, Dah);                 // vh + t*step
+
+        // A zero high word makes the exponent arithmetic meaningless (and can
+        // produce 0 * inf), so fall back to the plain sum there.
+        emit_movi_d_zero(buf, Ds1);
+        emit_fcmp_f64(buf, Dah, Ds1);
+        emit_fcsel_f64(buf, Dah, Dn, Ds3, /*cond=*/0x0);  // EQ (vh == 0) -> plain
+        free_gpr(a1, Xe);
+        free_gpr(a1, Xb);
+    }
+
+    // Release the scratch set BEFORE the sign step: emit_apply_qn_sign
+    // allocates for itself, and holding six FPRs across it exhausts the pool.
+    free_fpr(a1, Ds3);
+    free_fpr(a1, Ds2);
+    free_fpr(a1, Ds1);
+    free_fpr(a1, Dal);
+    free_fpr(a1, Dn);
+    free_fpr(a1, Dx);  // the fast path frees the input too; leaking it drains
+                       // the pool a register at a time until allocation fails
+
+    emit_apply_qn_sign(a1, buf, Dah, Xqn, /*Dd_out=*/Dah);
+    free_gpr(a1, Xqn);
+    return Dah;
+}
+
+// X87_EXACT is on when the caller asked for results that match real x87.
+static bool x87_exact_on() {
+    return g_rosetta_config != nullptr && g_rosetta_config->x87_exact != 0;
+}
+
 int emit_inline_trig_body(TranslationResult& a1, AssemblerBuffer& buf, int Dx, int Xconst,
                           TrigReduceMode mode) {
+    if (x87_exact_on()) {
+        // The exact path needs six scratch FPRs. Real game code often leaves
+        // fewer free than a microbenchmark does, and alloc_free_fpr asserts
+        // rather than failing soft, so check before committing to it.
+        if (__builtin_popcount(a1.free_fpr_mask) >= 6) {
+            return emit_x87_exact_trig(a1, buf, Dx, Xconst, mode);
+        }
+        static int short_of_regs = 0;
+        if (++short_of_regs <= 5 || short_of_regs % 1000 == 0) {
+            fprintf(stderr, "[x87exact] only %d FPRs free, fell back to the fast path (#%d)\n",
+                    __builtin_popcount(a1.free_fpr_mask), short_of_regs);
+            fflush(stderr);
+        }
+    }
     // 1. Range reduction → Dr, Xqn.  Last read of Dx.
     const int Dn = alloc_free_fpr(a1);
     const int Xqn = alloc_free_gpr(a1);
