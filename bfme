#!/bin/zsh
# BFME on macOS.
#
#   bfme launcher    the All in One Launcher: install/patch the game, mods, maps
#   bfme arena       ranked multiplayer through the Online Arena
#   bfme play        BFME 1 directly (skirmish, campaign)
#   bfme doctor      check the installation and print what it found
#   bfme run <exe>   run any Windows program in the prefix
#   bfme bootstrap   create/refresh the prefix and its settings
#   bfme make-apps   (re)create the apps in ~/Applications
#
# Your macOS display resolution is never changed.
set -u
BFME_SELF="${0:A}"          # zsh rebinds $0 inside functions, so capture it now
BFME_HOME="${BFME_SELF:h}"
BFME_TOOLS="$BFME_HOME/tools"
source "$BFME_HOME/bfme-config.sh"

BFME_WINE_ROOT=$(bfme_find_wine)   || exit 1
BFME_PREFIX_DIR=$(bfme_find_prefix)

ARENA_EXE="C:\\users\\$USER\\AppData\\Roaming\\BFME Competetive Arena\\BfmeFoundationProject_OnlineArena.exe"
LAUNCHER_EXE="C:\\users\\$USER\\AppData\\Roaming\\BFME All In One Launcher\\AllInOneLauncher.exe"

usage() { sed -n '2,12p' "$BFME_SELF" | sed 's/^# \{0,1\}//'; }

cmd_bootstrap() {
  print -r -- "Prefix: $BFME_PREFIX_DIR"
  if [ ! -f "$BFME_PREFIX_DIR/system.reg" ]; then
    print -r -- "  creating it (first run takes a minute)"
    mkdir -p "$BFME_PREFIX_DIR" || bfme_die "could not create $BFME_PREFIX_DIR"
    bfme_wine wineboot --init >/dev/null 2>&1 || bfme_die "wineboot failed"
    bfme_wineserver_wait
    [ -f "$BFME_PREFIX_DIR/system.reg" ] || bfme_die "the prefix was not created"
  fi
  bfme_ensure_wineserver
  bfme_configure_wine
  print -r -- "  ready"
}

cmd_launcher() {
  bfme_launch_guard "AllInOneLauncher.exe" "The All in One Launcher" || return 0
  bfme_stop_wine
  bfme_ensure_wineserver
  bfme_configure_wine
  bfme_launch_unlock
  exec_in_prefix "$LAUNCHER_EXE" "the All in One Launcher"
}

cmd_arena() {
  bfme_launch_guard "BfmeFoundationProject_OnlineArena.exe" "The Online Arena" || return 0
  bfme_stop_wine
  bfme_ensure_wineserver
  bfme_configure_wine
  bfme_configure_game
  bfme_launch_unlock
  exec_in_prefix "$ARENA_EXE" "the Online Arena"
}

cmd_play() {
  local game="$BFME_PREFIX_DIR/drive_c/BFME1/lotrbfme.exe"
  [ -x "$game" ] || bfme_die "BFME 1 not found at $game -- install it from 'bfme launcher' first"
  bfme_launch_guard "lotrbfme.exe" "BFME 1" || return 0
  bfme_stop_wine
  bfme_ensure_wineserver
  bfme_configure_wine
  bfme_configure_game
  bfme_launch_unlock
  print -r -- "Launching BFME 1..."
  cd "${game:h}" || bfme_die "could not enter ${game:h}"
  bfme_wine "$game" -noshellmap
}

exec_in_prefix() {
  local target="$1" what="$2"
  print -r -- "Launching $what..."
  bfme_wine "$target"
}

cmd_run() {
  [ $# -ge 1 ] || bfme_die "usage: bfme run <program.exe> [args...]"
  bfme_wine "$@"
}

cmd_doctor() {
  local ok=1
  print -r -- "bfme doctor"
  print -r -- "  machine        $(sw_vers -productVersion) / $(uname -m)"
  if /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null; then
    print -r -- "  rosetta 2      present"
  else
    print -r -- "  rosetta 2      MISSING -- softwareupdate --install-rosetta --agree-to-license"; ok=0
  fi
  print -r -- "  wine           $BFME_WINE_ROOT"
  local ver
  ver=$(bfme_wine --version 2>/dev/null) && print -r -- "                 $ver" \
    || { print -r -- "                 DOES NOT RUN"; ok=0; }
  print -r -- "  prefix         $BFME_PREFIX_DIR"
  [ -f "$BFME_PREFIX_DIR/system.reg" ] || { print -r -- "                 not created yet -- run 'bfme bootstrap'"; ok=0; }
  print -r -- "  display        $("$BFME_TOOLS/listmodes" 2>/dev/null | head -1 | sed 's/^current: //')"
  print -r -- "  scale          $(bfme_display_scale 2>/dev/null || echo '?')"
  local sc
  sc=$(bfme_display_scale 2>/dev/null) && \
    print -r -- "  game shown at  $(awk -v s=$sc 'BEGIN{printf "%dx%d points", 2560/s, 1440/s}')"
  local rel label
  for entry in "drive_c/BFME1/lotrbfme.exe|BFME 1" \
               "drive_c/users/$USER/AppData/Roaming/BFME All In One Launcher/AllInOneLauncher.exe|launcher" \
               "drive_c/users/$USER/AppData/Roaming/BFME Competetive Arena/BfmeFoundationProject_OnlineArena.exe|arena"; do
    rel="${entry%%|*}"; label="${entry##*|}"
    if [ -e "$BFME_PREFIX_DIR/$rel" ]; then printf '  %-14s installed\n' "$label"
    else printf '  %-14s not installed\n' "$label"; ok=0; fi
  done
  [ $ok -eq 1 ] || { print -r -- ""; print -r -- "Something above needs fixing."; return 1; }
}

cmd_make_apps() {
  local apps name cmd bundle spec other plist
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  local plistbuddy="/usr/libexec/PlistBuddy"
  # /Applications is where Spotlight and Launch Services expect to find apps, and
  # on a Mac whose owner is an admin it is group-writable without sudo. Fall back
  # to ~/Applications when it is not.
  if [ -w /Applications ]; then apps="/Applications"; other="$HOME/Applications"
  else apps="$HOME/Applications"; other="/Applications"; fi
  mkdir -p "$apps" || bfme_die "could not create $apps"
  print -r -- "  installing into $apps"

  for spec in "BFME Launcher:launcher" "BFME Arena:arena" "BFME Solo:play"; do
    name="${spec%%:*}"; cmd="${spec##*:}"
    bundle="$apps/$name.app"
    rm -rf "$bundle"

    # Built with osacompile rather than by hand. A bundle whose executable is a
    # shell script is not a real app: it never connects to the window server, so
    # macOS reports "not responding" and refuses to reopen it. An applet is a
    # genuine signed Cocoa binary; it spawns the game detached and then quits,
    # which leaves Wine running and no unresponsive app behind.
    osacompile -o "$bundle" \
      -e "do shell script \"'$BFME_HOME/bfme' $cmd > /dev/null 2>&1 &\"" \
      >/dev/null 2>&1 || bfme_die "could not build $bundle (osacompile failed)"

    plist="$bundle/Contents/Info.plist"
    "$plistbuddy" -c "Set :CFBundleName $name" "$plist" >/dev/null 2>&1 \
      || "$plistbuddy" -c "Add :CFBundleName string $name" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Add :CFBundleDisplayName string $name" "$plist" >/dev/null 2>&1 \
      || "$plistbuddy" -c "Set :CFBundleDisplayName $name" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Set :CFBundleIdentifier com.bfme-macos.$cmd" "$plist" >/dev/null 2>&1 \
      || "$plistbuddy" -c "Add :CFBundleIdentifier string com.bfme-macos.$cmd" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Add :LSApplicationCategoryType string public.app-category.strategy-games" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Add :CFBundleShortVersionString string 1.0" "$plist" >/dev/null 2>&1

    # Editing Info.plist invalidates the signature osacompile applied.
    codesign --force --sign - --timestamp=none "$bundle" >/dev/null 2>&1 \
      || print -r -- "  (warning: could not re-sign $name; it will still run)" >&2

    # A new bundle is not in the Launch Services database until something
    # registers it, and Spotlight's app results come from that database.
    [ -x "$lsregister" ] && "$lsregister" -f "$bundle" >/dev/null 2>&1
    print -r -- "  $bundle"
  done

  # Drop any copy left in the other location so there are not two of each.
  for spec in "BFME Launcher" "BFME Arena" "BFME Solo"; do
    [ -d "$other/$spec.app" ] && { rm -rf "$other/$spec.app"; print -r -- "  removed the stale copy in $other"; }
  done
  mdimport "$apps" >/dev/null 2>&1 || true
}

case "${1:-}" in
  launcher)   cmd_launcher ;;
  arena)      cmd_arena ;;
  play)       cmd_play ;;
  doctor)     cmd_doctor ;;
  bootstrap)  cmd_bootstrap ;;
  make-apps)  cmd_make_apps ;;
  prefix-path) print -r -- "$BFME_PREFIX_DIR" ;;
  wine-path)  print -r -- "$BFME_WINE_ROOT" ;;
  run)        shift; cmd_run "$@" ;;
  ""|-h|--help|help) usage ;;
  *)          print -r -- "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
