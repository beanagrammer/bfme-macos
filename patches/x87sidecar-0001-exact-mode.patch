+// X87_EXACT=1 — refuse every operation whose result is not bit-identical to
+// real x87, so a lockstep simulation stays in sync with players on x86.
+//
+// The inline transcendentals are within a ulp of the true result but do not
+// match Intel's, and one ulp is enough to desync a match. The irrational
+// constant loads lose their low mantissa bits for the same reason: they are
+// materialised as doubles.
+//
+// Excluding them HERE is the point. X87_STOCK_OPS tries to do this by
+// short-circuiting the translate request, which leaves deferred stack state
+// that already-emitted code still owes, and returns garbage. Refusing them in
+// is_handled_x87 instead makes the run break before the op, so x87_end flushes
+// deferred state and stock translates it against coherent X87State — exactly
+// how fclex/finit/fldenv/fstenv/fxsave/fxrstor already reach stock.
+bool x87_exact_mode() {
+    return g_rosetta_config != nullptr && g_rosetta_config->x87_exact != 0;
+}
+
+bool is_bit_exact_x87(uint16_t op) {
+    switch (op) {
+        case kOpcodeName_fsin:
+        case kOpcodeName_fcos:
+        case kOpcodeName_fsincos:
+        case kOpcodeName_fptan:
+        case kOpcodeName_fpatan:
+        case kOpcodeName_f2xm1:
+        case kOpcodeName_fyl2x:
+        case kOpcodeName_fyl2xp1:
+        case kOpcodeName_fprem:
+        case kOpcodeName_fprem1:
+        case kOpcodeName_fldpi:
+        case kOpcodeName_fldln2:
+        case kOpcodeName_fldl2e:
+        case kOpcodeName_fldl2t:
+        case kOpcodeName_fldlg2:
+            return false;
+        default:
+            return true;
+    }
+}
