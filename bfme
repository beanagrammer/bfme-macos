#!/bin/zsh
# BFME on macOS.
#
#   bfme launcher    the All in One Launcher: install/patch the game, mods, maps
#   bfme arena       ranked multiplayer through the Online Arena
#   bfme play        BFME 1 directly (skirmish, campaign)
#   bfme doctor      check the installation and print what it found
#   bfme run <exe>   run any Windows program in the prefix
#   bfme bootstrap   create/refresh the prefix and its settings
#   bfme make-apps   (re)create the apps in ~/Applications
#   bfme sync-safe on|off|status   trade x87 speed for results that match x86 players
#   bfme collect-desync            gather the evidence after an online game went out of sync
#   bfme validate-sync             play one match with the JIT off and collect the result
#
# Your macOS display resolution is never changed.
set -u
BFME_SELF="${0:A}"          # zsh rebinds $0 inside functions, so capture it now
BFME_HOME="${BFME_SELF:h}"
BFME_TOOLS="$BFME_HOME/tools"
source "$BFME_HOME/bfme-config.sh"

BFME_WINE_ROOT=$(bfme_find_wine)   || exit 1
BFME_PREFIX_DIR=$(bfme_find_prefix)

ARENA_EXE="C:\\users\\$USER\\AppData\\Roaming\\BFME Competetive Arena\\BfmeFoundationProject_OnlineArena.exe"
LAUNCHER_EXE="C:\\users\\$USER\\AppData\\Roaming\\BFME All In One Launcher\\AllInOneLauncher.exe"

usage() { sed -n '2,12p' "$BFME_SELF" | sed 's/^# \{0,1\}//'; }

cmd_bootstrap() {
  print -r -- "Prefix: $BFME_PREFIX_DIR"
  if [ ! -f "$BFME_PREFIX_DIR/system.reg" ]; then
    print -r -- "  creating it (first run takes a minute)"
    mkdir -p "$BFME_PREFIX_DIR" || bfme_die "could not create $BFME_PREFIX_DIR"
    bfme_wine wineboot --init >/dev/null 2>&1 || bfme_die "wineboot failed"
    bfme_wineserver_wait
    [ -f "$BFME_PREFIX_DIR/system.reg" ] || bfme_die "the prefix was not created"
  fi
  bfme_ensure_wineserver
  bfme_configure_wine
  print -r -- "  ready"
}

cmd_launcher() {
  bfme_launch_guard "AllInOneLauncher.exe" "The All in One Launcher" || return 0
  bfme_stop_wine
  bfme_ensure_wineserver
  bfme_configure_wine
  bfme_launch_unlock
  exec_in_prefix "$LAUNCHER_EXE" "the All in One Launcher"
}

cmd_arena() {
  bfme_launch_guard "BfmeFoundationProject_OnlineArena.exe" "The Online Arena" || return 0
  # The Arena is the online path, and online is where x87 differences bite: the
  # JIT's transcendentals do not match the x87 every opponent is running on.
  # Say so here rather than let a match end in "out of sync" with no clue why.
  if [ ! -f "$BFME_APP_SUPPORT/sync-safe" ]; then
    print -r -- "  note: sync-safe is OFF. Fast, but the x87 JIT's results differ from"
    print -r -- "        players on Windows, which can desync a ranked match."
    print -r -- "        'bfme sync-safe on' is bit-exact, at a much slower load."
  fi
  bfme_stop_wine
  bfme_ensure_wineserver
  bfme_configure_wine
  bfme_configure_game
  bfme_launch_unlock
  bfme_start_backdrop
  bfme_place_arena
  exec_in_prefix "$ARENA_EXE" "the Online Arena"
}

cmd_play() {
  local game="$BFME_PREFIX_DIR/drive_c/BFME1/lotrbfme.exe"
  [ -x "$game" ] || bfme_die "BFME 1 not found at $game -- install it from 'bfme launcher' first"
  bfme_launch_guard "lotrbfme.exe" "BFME 1" || return 0
  bfme_stop_wine
  bfme_ensure_wineserver
  bfme_configure_wine
  bfme_configure_game
  bfme_launch_unlock
  bfme_start_backdrop
  print -r -- "Launching BFME 1..."
  cd "${game:h}" || bfme_die "could not enter ${game:h}"
  bfme_wine "$game" -noshellmap
}

exec_in_prefix() {
  local target="$1" what="$2"
  print -r -- "Launching $what..."
  bfme_wine "$target"
}

cmd_run() {
  [ $# -ge 1 ] || bfme_die "usage: bfme run <program.exe> [args...]"
  bfme_wine "$@"
}

cmd_doctor() {
  local ok=1
  print -r -- "bfme doctor"
  print -r -- "  machine        $(sw_vers -productVersion) / $(uname -m)"
  if /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null; then
    print -r -- "  rosetta 2      present"
  else
    print -r -- "  rosetta 2      MISSING -- softwareupdate --install-rosetta --agree-to-license"; ok=0
  fi
  print -r -- "  wine           $BFME_WINE_ROOT"
  local ver
  ver=$(bfme_wine --version 2>/dev/null) && print -r -- "                 $ver" \
    || { print -r -- "                 DOES NOT RUN"; ok=0; }
  print -r -- "  prefix         $BFME_PREFIX_DIR"
  [ -f "$BFME_PREFIX_DIR/system.reg" ] || { print -r -- "                 not created yet -- run 'bfme bootstrap'"; ok=0; }
  # The x87 JIT fails silently -- the sidecar runs, its probe passes, and it
  # accelerates nothing. Measuring is the only way to know.
  # With the JIT off there is nothing to measure against: x87 runs on Rosetta,
  # which is the reference. Say so, rather than printing nothing and letting
  # silence read as "checks passed".
  if [ -n "${BFME_NO_X87:-}" ]; then
    print -r -- "  x87            JIT OFF (sync-safe) -- bit-exact with x86, loads ~16x slower"
  fi
  local bench="$BFME_TOOLS/x87check/x87bench.exe" jit nojit ratio
  if [ -f "$bench" ] && [ -z "${BFME_NO_X87:-}" ]; then
    jit=$(bfme_wine "$bench" 20000000 2>/dev/null | sed -n 's/.*(\([0-9.]*\) Miter.*/\1/p')
    nojit=$(BFME_NO_X87=1 bfme_wine "$bench" 20000000 2>/dev/null | sed -n 's/.*(\([0-9.]*\) Miter.*/\1/p')
    if [ -n "$jit" ] && [ -n "$nojit" ]; then
      ratio=$(awk -v a="$jit" -v b="$nojit" 'BEGIN{ if (b>0) printf "%.1f", a/b; else print "0" }')
      printf '  x87 JIT        %s Miter/s vs %s without (%sx)\n' "$jit" "$nojit" "$ratio"
      if [ "$(awk -v r="$ratio" 'BEGIN{print (r < 3) ? 1 : 0}')" = "1" ]; then
        print -r -- "                 NOT WORKING -- loads will take minutes. See docs/HOW-IT-WORKS.md"
        ok=0
      fi
    else
      print -r -- "  x87 JIT        could not measure"
    fi
  fi
  # Speed is not the only thing that can be wrong. BFME is a lockstep
  # simulation, so if the JIT's results differ from the x87 everyone else runs
  # on, online games desync within seconds. Compare the bits against Rosetta's
  # own emulation at the 0x027F control word Windows uses; the other two
  # precision modes are known to differ and are not what the game runs at.
  #
  # The filter must not eat the section headers -- they start with '[' too, and
  # a filter that removes them makes both sides empty and the check pass by
  # comparing nothing. That is exactly how a broken build once looked clean.
  local exact="$BFME_TOOLS/x87check/x87exact.exe" a b
  if [ -f "$exact" ] && [ -z "${BFME_NO_X87:-}" ]; then
    a=$(bfme_wine "$exact" 2>/dev/null | grep -vE '^\[(rosettax87|x87stock|x87trace)\]' | sed -n '/0x027F/,/0x037F/p')
    b=$(BFME_NO_X87=1 bfme_wine "$exact" 2>/dev/null | grep -vE '^\[(rosettax87|x87stock|x87trace)\]' | sed -n '/0x027F/,/0x037F/p')
    if [ -z "$a" ] || [ -z "$b" ]; then
      print -r -- "  x87 exactness  COULD NOT MEASURE -- treat as unknown, not as passing"
    elif [ "$a" = "$b" ]; then
      print -r -- "  x87 exactness  bit-exact with Rosetta"
    else
      local n
      n=$(diff <(print -r -- "$a") <(print -r -- "$b") | grep -c '^<')
      print -r -- "  x87 exactness  $n lines differ from real x87 -- online games may desync"
      print -r -- "                 single player is unaffected. See patches/x87sidecar-README.md"
    fi
  fi
  print -r -- "  display        $("$BFME_TOOLS/listmodes" 2>/dev/null | head -1 | sed 's/^current: //')"
  print -r -- "  scale          $(bfme_display_scale 2>/dev/null || echo '?')"
  local sc
  sc=$(bfme_display_scale 2>/dev/null) && \
    print -r -- "  game shown at  $(awk -v s=$sc 'BEGIN{printf "%dx%d points", 2560/s, 1440/s}')"
  local rel label
  for entry in "drive_c/BFME1/lotrbfme.exe|BFME 1" \
               "drive_c/users/$USER/AppData/Roaming/BFME All In One Launcher/AllInOneLauncher.exe|launcher" \
               "drive_c/users/$USER/AppData/Roaming/BFME Competetive Arena/BfmeFoundationProject_OnlineArena.exe|arena"; do
    rel="${entry%%|*}"; label="${entry##*|}"
    if [ -e "$BFME_PREFIX_DIR/$rel" ]; then printf '  %-14s installed\n' "$label"
    else printf '  %-14s not installed\n' "$label"; ok=0; fi
  done
  [ $ok -eq 1 ] || { print -r -- ""; print -r -- "Something above needs fixing."; return 1; }
}

cmd_make_apps() {
  local apps name cmd icon bundle spec other plist icons
  local -a parts
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  local plistbuddy="/usr/libexec/PlistBuddy"
  # /Applications is where Spotlight and Launch Services expect to find apps, and
  # on a Mac whose owner is an admin it is group-writable without sudo. Fall back
  # to ~/Applications when it is not.
  if [ -w /Applications ]; then apps="/Applications"; other="$HOME/Applications"
  else apps="$HOME/Applications"; other="/Applications"; fi
  mkdir -p "$apps" || bfme_die "could not create $apps"
  print -r -- "  installing into $apps"

  # The apps show the real game/Arena/launcher artwork, taken from the Windows
  # executables that are already installed on this Mac. It is extracted here
  # rather than shipped with this tool because the artwork is not ours to
  # redistribute. An app with no icon still launches the game, so a failure
  # here is reported and then stepped over.
  icons="$BFME_HOME/icons"
  if [ -f "$BFME_TOOLS/make-icons.py" ]; then
    python3 "$BFME_TOOLS/make-icons.py" "$icons" \
      || print -r -- "  (warning: no icons were built, so the apps will look generic)" >&2
  else
    print -r -- "  (warning: $BFME_TOOLS/make-icons.py is missing, so the apps will look generic)" >&2
  fi

  for spec in "BFME Launcher:launcher:launcher" "BFME Arena:arena:arena" "BFME Solo:play:game"; do
    parts=("${(@s/:/)spec}"); name="$parts[1]"; cmd="$parts[2]"; icon="$parts[3]"
    bundle="$apps/$name.app"
    rm -rf "$bundle"

    # Built with osacompile rather than by hand. A bundle whose executable is a
    # shell script is not a real app: it never connects to the window server, so
    # macOS reports "not responding" and refuses to reopen it. An applet is a
    # genuine signed Cocoa binary; it spawns the game detached and then quits,
    # which leaves Wine running and no unresponsive app behind.
    osacompile -o "$bundle" \
      -e "do shell script \"'$BFME_HOME/bfme' $cmd > /dev/null 2>&1 &\"" \
      >/dev/null 2>&1 || bfme_die "could not build $bundle (osacompile failed)"

    plist="$bundle/Contents/Info.plist"
    "$plistbuddy" -c "Set :CFBundleName $name" "$plist" >/dev/null 2>&1 \
      || "$plistbuddy" -c "Add :CFBundleName string $name" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Add :CFBundleDisplayName string $name" "$plist" >/dev/null 2>&1 \
      || "$plistbuddy" -c "Set :CFBundleDisplayName $name" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Set :CFBundleIdentifier com.bfme-macos.$cmd" "$plist" >/dev/null 2>&1 \
      || "$plistbuddy" -c "Add :CFBundleIdentifier string com.bfme-macos.$cmd" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Add :LSApplicationCategoryType string public.app-category.strategy-games" "$plist" >/dev/null 2>&1
    "$plistbuddy" -c "Add :CFBundleShortVersionString string 1.0" "$plist" >/dev/null 2>&1

    if [ -f "$icons/$icon.icns" ]; then
      cp "$icons/$icon.icns" "$bundle/Contents/Resources/applet.icns" \
        || bfme_die "could not put the icon into $bundle"
      # osacompile sets both CFBundleIconName and CFBundleIconFile to "applet".
      # The first one resolves through the compiled Assets.car, which still holds
      # the stock AppleScript icon and wins, so it has to go.
      "$plistbuddy" -c "Delete :CFBundleIconName" "$plist" >/dev/null 2>&1
    fi

    # Editing Info.plist invalidates the signature osacompile applied.
    codesign --force --sign - --timestamp=none "$bundle" >/dev/null 2>&1 \
      || print -r -- "  (warning: could not re-sign $name; it will still run)" >&2

    # A new bundle is not in the Launch Services database until something
    # registers it, and Spotlight's app results come from that database.
    [ -x "$lsregister" ] && "$lsregister" -f "$bundle" >/dev/null 2>&1
    print -r -- "  $bundle"
  done

  # Drop any copy left in the other location so there are not two of each.
  for spec in "BFME Launcher" "BFME Arena" "BFME Solo"; do
    [ -d "$other/$spec.app" ] && { rm -rf "$other/$spec.app"; print -r -- "  removed the stale copy in $other"; }
  done
  mdimport "$apps" >/dev/null 2>&1 || true
}

# After an online game goes out of sync there is a short window in which the
# evidence still exists: the game writes a desync report naming the subsystem
# that mismatched, and the Arena's log is truncated on its next launch. This
# grabs all of it before that happens. Run it straight after the match.
# One command for the experiment that decides whether the x87 JIT is what
# desynchronises online games. It is the only question left that cannot be
# answered from this machine, because it needs a real opponent.
#
# Turns the JIT off, starts the Arena, waits for the session to end, and
# collects the evidence immediately -- the Arena rewrites its log on its next
# launch, so doing it by hand afterwards usually means doing it too late.
cmd_validate_sync() {
  cmd_sync_safe on
  local out="$HOME/Desktop/bfme-sync-test-$(date +%Y%m%d-%H%M%S)"
  print -r --
  print -r -- "  Starting the Arena with the x87 JIT off."
  print -r -- "  Loading a match takes about five minutes. The frame rate is normal."
  print -r -- "  Play one game, then leave the Arena."
  print -r --
  print -r -- "  Keep this terminal open: the evidence is gathered when the game exits."
  print -r --
  ( cmd_arena >/dev/null 2>&1 & )
  # Give the Arena time to appear before watching for it to go away.
  local w=0
  while [ "$w" -lt 60 ]; do
    pgrep -f "BfmeFoundationProject_OnlineArena.exe" >/dev/null && break
    sleep 2; w=$((w+2))
  done
  if ! pgrep -f "BfmeFoundationProject_OnlineArena.exe" >/dev/null; then
    print -r -- "  the Arena did not start; nothing to validate" >&2
    return 1
  fi
  print -r -- "  Arena running. Waiting for the session to end..."
  while pgrep -f "BfmeFoundationProject_OnlineArena.exe|lotrbfme.exe" >/dev/null; do
    sleep 10
  done
  print -r -- "  session ended; collecting"
  cmd_collect_desync "$out"
  print -r --
  print -r -- "  If the match stayed in sync, the x87 JIT was the cause and"
  print -r -- "  'bfme sync-safe on' is the fix. If it went out of sync anyway,"
  print -r -- "  the collected report names what actually mismatched."
}

cmd_collect_desync() {
  local out="${1:-$HOME/Desktop/bfme-desync-$(date +%Y%m%d-%H%M%S)}"
  mkdir -p "$out" || bfme_die "could not create $out"
  local c="$BFME_PREFIX_DIR/drive_c"
  local roam="$c/users/$USER/AppData/Roaming"
  local found=0 f

  # The reports themselves: CLIENT_DESYNC_*.txt and DESYNC-*-*.txt. Anywhere in
  # the prefix, because the game's idea of "current directory" varies.
  for f in $(find "$c" -iname '*desync*' -type f 2>/dev/null); do
    cp "$f" "$out/" 2>/dev/null && found=$((found+1))
  done

  # The Arena's own log, which is rewritten from scratch on its next launch.
  [ -f "$c/BFME1/arenaapilog.txt" ] && cp "$c/BFME1/arenaapilog.txt" "$out/"
  # What the game was configured to do, and the replay if one was written.
  [ -f "$roam/My Battle for Middle-earth Files/Options.ini" ] && \
    cp "$roam/My Battle for Middle-earth Files/Options.ini" "$out/"
  for f in $(find "$roam/My Battle for Middle-earth Files/Replays" -name '*.rep' 2>/dev/null); do
    cp "$f" "$out/" 2>/dev/null
  done

  # Which x87 mode was in force, since that is the variable under test.
  { print -r -- "collected $(date)"
    print -r -- "sync-safe: $([ -f "$BFME_APP_SUPPORT/sync-safe" ] && echo ON || echo OFF)"
    print -r -- "prefix:    $BFME_PREFIX_DIR"
    print -r -- "wine:      $BFME_WINE_ROOT"
    print -r -- "desync reports found: $found"
  } > "$out/context.txt"

  print -r -- "  collected into $out"
  if [ "$found" -gt 0 ]; then
    print -r -- "  $found desync report(s) -- these name the subsystem that mismatched"
  else
    print -r -- "  no desync report was written; the game only writes one for some"
    print -r -- "  mismatch kinds, so its absence does not mean the game stayed in sync"
  fi
}

cmd_sync_safe() {
  local marker="$BFME_APP_SUPPORT/sync-safe"
  case "$1" in
    on)
      mkdir -p "$BFME_APP_SUPPORT" || bfme_die "could not create $BFME_APP_SUPPORT"
      : > "$marker" || bfme_die "could not write $marker"
      print -r -- "sync-safe ON: x87 runs on Rosetta, which is bit-exact with x86."
      print -r -- "  Loads and x87-heavy work get roughly 9x slower. Frame rate is unaffected."
      print -r -- "  This applies to the apps launched from Spotlight too."
      ;;
    off)
      rm -f "$marker"
      print -r -- "sync-safe OFF: the x87 JIT is on. Fast, but its transcendentals are"
      print -r -- "  one unit in the last place off from real x87, which can desync online games."
      ;;
    status)
      if [ -f "$marker" ]; then print -r -- "sync-safe is ON  (bit-exact, slower)"
      else print -r -- "sync-safe is OFF (fast, may desync online)"; fi
      ;;
    *) print -r -- "usage: bfme sync-safe on|off|status" >&2; return 2 ;;
  esac
}

case "${1:-}" in
  launcher)   cmd_launcher ;;
  arena)      cmd_arena ;;
  play)       cmd_play ;;
  doctor)     cmd_doctor ;;
  bootstrap)  cmd_bootstrap ;;
  make-apps)  cmd_make_apps ;;
  sync-safe)  shift; cmd_sync_safe "${1:-status}" ;;
  collect-desync) shift; cmd_collect_desync "${1:-}" ;;
  validate-sync)  cmd_validate_sync ;;
  prefix-path) print -r -- "$BFME_PREFIX_DIR" ;;
  wine-path)  print -r -- "$BFME_WINE_ROOT" ;;
  run)        shift; cmd_run "$@" ;;
  ""|-h|--help|help) usage ;;
  *)          print -r -- "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
