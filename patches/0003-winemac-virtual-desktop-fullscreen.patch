 }
 
 
+/* A window spanning a screen's full width and reaching its top edge needs the
+   same window level as a fullscreen one: at the normal level the menu bar is
+   drawn over its top rows.  Only used when ConstrainWindows is off, i.e. when
+   the windows are deliberately placed exactly where Win32 puts them, so the
+   window really is meant to start at the very top-left of the screen. */
+static NSScreen* screen_topped_by_rect(NSRect rect, NSArray* screens)
+{
+    /* Window frames are fractional, and a scaled desktop lands a fraction of a
+       point short of the screen edge, so compare with a one point tolerance
+       rather than exactly. */
+    static const CGFloat tolerance = 1.0;
+
+    for (NSScreen* screen in screens)
+    {
+        NSRect frame = [screen frame];
+        if (NSMinX(rect) <= NSMinX(frame) + tolerance &&
+            NSMaxX(rect) >= NSMaxX(frame) - tolerance &&
+            NSMaxY(rect) >= NSMaxY(frame) - tolerance)
+            return screen;
+    }
+    return nil;
+}
+
